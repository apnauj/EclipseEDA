public class Factorial {
	
	public static long factorial(long n) {
		long f = 1;
		for (int i = 2; i <= n; i++) {
			f *= i;
		}
		return f;
	}
	
	public static long factorialRecursivo(long n) {
		if(n == 0 || n == 1) return 1;
		return n * factorialRecursivo(n - 1);
	}
	
	public static long fibonacci(long n) {
		if(n == 0) return 0;
		if(n == 1) return 1;
		
		return fibonacci(n-1) + fibonacci(n-2);
	}
	
	public static long fibonacciFor(long n) {
		if(n == 0) return 0;
		if(n == 1) return 1;
		long aux;
		long previo1 = 1;
		long previo2 = 1;
		
		for (int i = 0; i < (n-2); i++ ) {
			aux = previo1;
			
			previo1 = previo1 + previo2;
			previo2 = aux;
			
		}
		return previo1;
	}
	
	
	public static void main(String args[]) {
		long n = 20; 
		
		//Comparación Factoriales
		
        long inicioIterativoFactorial = System.nanoTime();
        long resultadoIterativoFactorial = factorial(n);
        long finIterativoFactorial = System.nanoTime();
        
        long inicioRecursivoFactorial = System.nanoTime();
        long resultadoRecursivoFactorial = factorialRecursivo(n);
        long finRecursivoFactorial = System.nanoTime();

        System.out.println("Resultado iterativo Factorial: " + resultadoIterativoFactorial);
        System.out.println("Resultado recursivo Factorial: " + resultadoRecursivoFactorial);
        System.out.println("Tiempo Iterativo Factorial: " + (finIterativoFactorial - inicioIterativoFactorial) + " ns");
        System.out.println("Tiempo Recursivo Factorial: " + (finRecursivoFactorial - inicioRecursivoFactorial) + " ns");
        
      //Comparación Fibonaccis
        
        long m = 40;
        
        long inicioIterativoFibonacci = System.nanoTime();
        long resultadoIterativoFibonacci = fibonacciFor(m);
        long finIterativoFibonacci = System.nanoTime();
        
        long inicioRecursivoFibonacci = System.nanoTime();
        long resultadoRecursivoFibonacci = fibonacci(m);
        long finRecursivoFibonacci = System.nanoTime();

        System.out.println("Resultado iterativo Fibonacci: " + resultadoIterativoFibonacci);
        System.out.println("Resultado recursivo Fibonacci: " + resultadoRecursivoFibonacci);
        System.out.println("Tiempo Iterativo Fibonacci: " + (finIterativoFibonacci - inicioIterativoFibonacci) + " ns");
        System.out.println("Tiempo Recursivo Fibonacci: " + (finRecursivoFibonacci - inicioRecursivoFibonacci) + " ns");
        
		
	}
}
